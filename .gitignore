.pio/
**/.pio/

# Editor and OS files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.DS_Store
Thumbs.db

# Python caches (3D model generator scripts)
__pycache__/
*.pyc

# Local Claude Code settings
.claude/settings.local.json

